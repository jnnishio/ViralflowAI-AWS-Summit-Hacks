# Local-first demo: point the SPA at the local Node dev server
# (frontend/mock-server/server.mjs), which runs the real Python pipeline as a
# subprocess and/or serves pre-computed cached clips. Used by `npm run dev`.
VITE_REST_API_URL=http://localhost:3000
VITE_WS_API_URL=ws://localhost:3001

# "Open in Editor" deep-links into the vendored OpenCut editor app
# (apps/editor). It runs its own Next.js dev server — keep it OFF port 3000
# (the pipeline server). Run it with `bun run dev:highlight` (port 3100).
VITE_EDITOR_BASE_URL=http://localhost:3100
# Leave VITE_EDITOR_VIDEO_ID unset: each "Open in Editor" link now uses
# video_{jobId} dynamically, and the editor (pointed at this server's
# editor-shaped /api via NEXT_PUBLIC_BACKEND_API_URL) loads that run's real
# clips + auto-edit.
