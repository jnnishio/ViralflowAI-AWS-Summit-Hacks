# Production build for the single-container cached demo (Fly.io).
# All endpoints are SAME-ORIGIN: the Node server serves the built SPA, the REST
# API, the media, and the WebSocket on one port. Empty values make the client
# use relative/derived URLs so the build works on whatever host it lands on.
#
# REST empty -> fetch('/jobs') resolves against the page origin.
VITE_REST_API_URL=
# WS empty -> config.ts derives ws(s)://<page-host> (same origin, shared port).
VITE_WS_API_URL=
# Editor app is not deployed in the cached demo -> empty hides "Open in Editor".
VITE_EDITOR_BASE_URL=
