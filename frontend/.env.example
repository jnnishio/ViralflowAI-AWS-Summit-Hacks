# Frontend environment (copy to `.env` for the old cloud build; not needed for
# the local-first demo, which uses `.env.demo`). All values are non-secret
# endpoint identifiers — fill in your own if you deploy the dormant AWS stack.

# REST + WebSocket endpoints the SPA talks to.
# Local dev uses http://localhost:3000 (see .env.demo). For a cloud deploy,
# point these at your API Gateway stage.
VITE_REST_API_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/prod
VITE_WS_API_URL=wss://your-ws-api-id.execute-api.us-east-1.amazonaws.com/prod

# Cognito (only used by the cloud build; auth is skipped on localhost).
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
